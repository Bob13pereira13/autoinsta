// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  /// scrypt hash (lib/auth/password.ts). Null until the user sets a password.
  passwordHash      String?
  /// Sessions issued before this instant are rejected (lib/auth.ts).
  passwordChangedAt DateTime?
  /// Set to block sign-in (npm run user -- disable <email>).
  disabledAt        DateTime?
  /// Version of the Terms of Use and Privacy Policy accepted at sign-up (the
  /// legal pages' revision date, config/brand.ts) and when.
  termsVersion      String?
  termsAcceptedAt   DateTime?
  /// Interface language at sign-up ("pt-BR" | "en"), for the e-mails sent later.
  locale            String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authTokens       AuthToken[]
  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-use links sent by e-mail to set a password: WELCOME when an account
/// is created by the operator, RESET for "forgot my password". Only the SHA-256
/// of the token is stored.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthTokenPurpose {
  WELCOME
  RESET
  /// Confirms the address of a public sign-up.
  VERIFY_EMAIL
}

/// The client's (workspace's) standing. Only ACTIVE workspaces reach the
/// dashboard and fire automations. Existing workspaces became ACTIVE.
enum WorkspaceStatus {
  PENDING_APPROVAL
  ACTIVE
  DISABLED
  REJECTED
}

enum WorkspaceSignupSource {
  /// Created before public sign-up existed, or by `npm run user`.
  LEGACY
  SELF_SIGNUP
  ADMIN
}

enum DocumentType {
  CPF
  CNPJ
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  /// Default ACTIVE so the operator script and automatic workspace creation
  /// keep working; public sign-up sets PENDING_APPROVAL explicitly.
  status                WorkspaceStatus       @default(ACTIVE)
  statusChangedAt       DateTime              @default(now())
  /// Last time the workspace became ACTIVE (approval or reactivation). The
  /// comment reconciler never answers comments made before it.
  automationsResumedAt  DateTime?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  /// Sent to the client by e-mail and shown after sign-in.
  rejectionReason       String?
  /// How many Instagram accounts the client may connect (set by the admin).
  /// Null = follow PlatformSettings.defaultInstagramAccountLimit (which may
  /// itself be null = no limit).
  instagramAccountLimit Int?
  signupSource          WorkspaceSignupSource @default(LEGACY)
  /// Public sign-up made while approval was not required: the workspace turns
  /// ACTIVE when the e-mail is confirmed, if approval is still off by then.
  signupAutoActivate    Boolean               @default(false)
  companyName           String?
  /// E.164, e.g. +5511999998888 (WhatsApp).
  contactPhone          String?
  documentType          DocumentType?
  /// Digits (CPF/CNPJ) or the alphanumeric CNPJ, uppercase, no punctuation.
  documentNumber        String?
  /// Admin-only notes.
  internalNotes         String?
  /// Billing, not used yet: a price per account for this client (null = the
  /// platform default in PlatformSettings) and the gateway's customer id.
  pricePerAccountCents  Int?
  billingCustomerId     String?

  zernioConnection  ZernioConnection?
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  automationMedia   AutomationMedia[]
  adminAuditLogs    AdminAuditLog[]

  @@index([ownerId])
  @@index([status])
}

/// Platform-wide settings edited in the admin area (single row, id "default").
model PlatformSettings {
  id                           String   @id @default("default")
  /// Price per Instagram account, in cents; only used for the estimated
  /// revenue until billing exists.
  pricePerAccountCents         Int      @default(19900)
  /// Instagram account limit for clients that follow the default; null = no limit.
  defaultInstagramAccountLimit Int?
  /// Public sign-ups wait for an admin's approval (true) or become ACTIVE as
  /// soon as the e-mail is confirmed (false, the default).
  requireSignupApproval        Boolean  @default(false)
  currency                     String   @default("BRL")
  updatedAt                    DateTime @updatedAt
  updatedBy                    String?
}

/// Every admin action: who, what, when, before/after. When a rejected sign-up
/// is purged, only the decision row survives, with personal data removed and
/// the client's e-mail kept as a SHA-256 hash.
model AdminAuditLog {
  id               String   @id @default(cuid())
  actorEmail       String
  workspaceId      String?
  subjectEmailHash String?
  action           String
  before           Json?
  after            Json?
  reason           String?
  createdAt        DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                   String            @id @default(cuid())
  workspaceId          String
  instagramId          String            @unique
  username             String
  name                 String?
  provider             InstagramProvider @default(META)
  /// Which Meta setup issued the token, for META accounts. Existing rows are
  /// INSTAGRAM: their tokens only work on graph.instagram.com. UNIFIED tokens
  /// are business system user tokens that only work on graph.facebook.com.
  metaLogin            MetaLogin         @default(INSTAGRAM)
  zernioAccountId      String?
  /// App-scoped Instagram user id (`id` from /me). Meta's data deletion and
  /// deauthorize callbacks may identify the user by this id instead of
  /// `instagramId` (the professional account id), so both are stored.
  instagramScopedId    String?
  /// Unified login only: the user id debug_token reports for the token (the
  /// business system user). Also matched by the data deletion / deauthorize
  /// callbacks, since Meta does not document which id they send for this flow.
  metaLoginUserId      String?
  /// Long-lived token, AES-256-GCM encrypted (lib/meta/oauth.ts). Empty when
  /// the user removed the app on Instagram.
  accessToken          String
  tokenExpiresAt       DateTime?
  /// Set when Meta rejects the token (revoked, expired or the app was removed
  /// on Instagram). Cleared on reconnect.
  tokenInvalidAt       DateTime?
  webhookSubscribed    Boolean           @default(false)
  /// Off: no automation of this account fires (comments, stories, Direct
  /// are ignored), but nothing is deleted. Switched in the Accounts tab.
  automationsEnabled   Boolean           @default(true)
  /// Last time automationsEnabled went back on. The comment reconciler never
  /// answers comments made before it (comments during the pause stay ignored).
  automationsResumedAt DateTime?
  connectedAt          DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations          Automation[]
  dmLogs               DmLog[]
  linkClicks           LinkClick[]
  conversationActivity ConversationActivity[]

  @@index([workspaceId])
  @@index([instagramScopedId])
  @@index([metaLoginUserId])
}

model Automation {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name                    String
  goal                    String?
  postId                  String?
  postUrl                 String?
  pendingNextReel         Boolean        @default(false)
  matchAnyPost            Boolean        @default(false)
  keywords                String[]
  matchAnyWord            Boolean        @default(false)
  /// Which channel triggers this automation. Existing rows are COMMENTS.
  type                    AutomationType @default(COMMENTS)
  /// STORIES only: answer replies to the account's stories.
  triggerStoryReplies     Boolean        @default(true)
  /// STORIES only: answer when someone mentions the account in their story.
  /// A mention has no text, so only automations without keywords fire on it.
  triggerStoryMentions    Boolean        @default(false)
  /// STORIES/DIRECT without keywords: reply to the same person at most once
  /// per this many hours.
  replyCooldownHours      Int            @default(24)
  /// Deprecated: replaced by DIRECT/STORIES automations (the migration that
  /// added `type` converted every true value). Kept, always false, so API v1
  /// readers keep the field.
  dmTriggerEnabled        Boolean        @default(false)
  dmMessage               String
  openingDmEnabled        Boolean        @default(false)
  openingDmMessage        String?
  openingDmButtonLabel    String?
  linkButtonLabel         String?
  requireFollow           Boolean        @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled         Boolean        @default(false)
  followUpMessage         String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes    Int            @default(0)
  publicReplyEnabled      Boolean        @default(false)
  publicReplyMessage      String?
  publicReplyMessages     String[]       @default([])
  isActive                Boolean        @default(true)
  /// When the automation was created or last resumed. The comment reconciler
  /// only answers comments made after it (and after the account's
  /// automationsResumedAt), unless replyToRecentComments is on.
  activeSince             DateTime       @default(now())
  /// COMMENTS: also answer comments made up to 72 hours before activeSince.
  replyToRecentComments   Boolean        @default(false)
  wholeWordMatch          Boolean        @default(true)
  reportShareSlug         String?        @unique
  reportShareEnabled      Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount  @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]
  media            AutomationMedia[]
  posts            AutomationPost[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
  @@index([instagramAccountId, type, isActive])
}

model DmLog {
  id                 String @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId    String
  commenterName  String?
  commentText    String
  commentId      String
  matchedKeyword String?
  status         DmStatus  @default(PENDING)
  attempts       Int       @default(0)
  dmSentAt       DateTime?
  errorMessage   String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  dmDeliveryUnconfirmed          Boolean   @default(false)
  publicReplyDeliveryUnconfirmed Boolean   @default(false)
  publicReplySentAt              DateTime?
  publicReplyError               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([automationId, commenterId, dmSentAt])
  @@index([commentId])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DmLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  // Which DM button this link is, starting at 0. Read links with
  // TRACKED_LINK_ORDER (lib/tracking/link-order.ts), never by createdAt alone:
  // links saved in one request share a createdAt, and Postgres returns tied
  // rows in no fixed order.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  // Token from the link's `?r=` (hashRecipientId), set on links sent in a DM.
  // Clicks are counted once per recipient, falling back to ipHash without it.
  recipientHash      String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  object       String?
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                 @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel  @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

/// A data deletion request received from Meta's Data Deletion Request
/// Callback (POST /api/webhooks/meta/data-deletion). The confirmation code is
/// what Meta shows the user; /exclusao-dados?codigo=... displays the status.
model DataDeletionRequest {
  id               String             @id @default(cuid())
  confirmationCode String             @unique
  /// SHA-256 of the user id Meta sent. Kept after completion for audit.
  metaUserIdHash   String
  /// The raw user id, kept only while the deletion is pending so a failed
  /// attempt can be retried. Cleared once the request is finished.
  metaUserId       String?
  status           DataDeletionStatus @default(RECEIVED)
  accountsDeleted  Int                @default(0)
  errorMessage     String?
  requestedAt      DateTime           @default(now())
  completedAt      DateTime?

  @@index([metaUserIdHash])
  @@index([status])
}

enum DataDeletionStatus {
  RECEIVED
  COMPLETED
  NOT_FOUND
  FAILED
}

enum AutomationType {
  COMMENTS
  STORIES
  DIRECT
}

/// Which configurable message a media file belongs to.
enum MessageSlot {
  OPENING
  FOLLOW_PROMPT
  MAIN
  FOLLOW_UP
}

enum MediaKind {
  IMAGE
  VIDEO
}

/// An image or video uploaded from the dashboard (lib/media/storage.ts). The
/// file lives in UPLOADS_DIR under `storageKey` and is served publicly at
/// /media/<storageKey> so Meta can download it. `automationId` is null between
/// the upload and saving the automation; unattached uploads are purged daily.
model AutomationMedia {
  id           String       @id @default(cuid())
  workspaceId  String
  automationId String?
  slot         MessageSlot?
  position     Int          @default(0)
  kind         MediaKind
  mimeType     String
  sizeBytes    Int
  storageKey   String       @unique
  originalName String?
  createdAt    DateTime     @default(now())

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation? @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
}

/// The posts and reels a COMMENTS automation is limited to. None (with
/// matchAnyPost) means every post. Automation.postId mirrors the first row so
/// API v1 readers and older code keep working.
model AutomationPost {
  automationId String
  /// Instagram media id.
  postId       String
  postUrl      String?
  /// When the post was published (from the picker); the reconciler polls the
  /// most recent ones first.
  publishedAt  DateTime?
  position     Int       @default(0)
  createdAt    DateTime  @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@id([automationId, postId])
  @@index([postId])
}

/// Message ids (mid) of DMs sent by the automations. An echo webhook whose mid
/// is not here was sent by a person (Instagram app, Business Suite, Inbox).
/// Keyed by the Instagram account id the worker and the echo both know;
/// kept 7 days (lib/privacy/purge.ts) and deleted with the account.
model BotMessage {
  mid         String   @id
  instagramId String
  recipientId String?
  createdAt   DateTime @default(now())

  @@index([instagramId])
  @@index([createdAt])
}

/// Last time a human from the account messaged this person; no-keyword
/// STORIES/DIRECT automations stay quiet for 24 hours after it.
model ConversationActivity {
  instagramAccountId String
  recipientId        String
  lastHumanMessageAt DateTime

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@id([instagramAccountId, recipientId])
  @@index([lastHumanMessageAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
  /// No-keyword STORIES/DIRECT automation already answered this person
  /// within replyCooldownHours.
  SKIPPED_COOLDOWN
  /// No-keyword STORIES/DIRECT: a human from the account talked to this
  /// person in the last 24 hours.
  SKIPPED_HUMAN_ACTIVE
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}

enum InstagramProvider {
  META
  ZERNIO
}

/// Instagram Login (Business Login for Instagram) or Meta's Unified login.
enum MetaLogin {
  INSTAGRAM
  UNIFIED
}

model ZernioConnection {
  workspaceId   String    @id
  apiKey        String
  profileId     String?
  webhookId     String?
  webhookSecret String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id        String   @id
  createdAt DateTime @default(now())
}
