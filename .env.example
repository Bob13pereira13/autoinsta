# Todos os valores abaixo são EXEMPLOS PÚBLICOS. Em produção (NODE_ENV=production)
# o app web e o worker se recusam a iniciar se NEXTAUTH_SECRET, CRON_SECRET,
# ENCRYPTION_KEY, FACEBOOK_APP_SECRET, INSTAGRAM_APP_SECRET ou WEBHOOK_VERIFY_TOKEN
# ainda tiverem o valor de exemplo (veja lib/env-safety.ts).

# ─────────────────────────────────────────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────────────────────────────────────────
# URL pública HTTPS do app (sem barra no final). Usada no callback OAuth, nos
# links de e-mail e na URL de status da exclusão de dados.
NEXTAUTH_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
# Protege as rotas /api/cron/* (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=replace-with-a-strong-random-secret
# Chave AES-256-GCM dos tokens do Instagram: 64 caracteres hex.
# Gere com: openssl rand -hex 32  — NÃO troque depois de ter contas conectadas
# (os tokens salvos deixariam de ser legíveis e os clientes teriam de reconectar).
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# E-mails dos operadores da plataforma (você), separados por vírgula. Só eles
# entram na área de gestão (/admin: aprovar cadastros, clientes, auditoria),
# recebem o aviso de cada cadastro novo e veem no Diagnóstico os eventos de
# todos os clientes. Clientes nunca veem dados de outros espaços de trabalho.
ADMIN_EMAILS=voce@suaempresa.com.br

# Cloudflare Turnstile (anti-robô do cadastro público /cadastro). Crie um widget
# em dash.cloudflare.com → Turnstile com o domínio do app. Lidas em tempo de
# execução (não precisa rebuild). Sem elas, em produção o cadastro fica fechado.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ─────────────────────────────────────────────────────────────────────────────
# Banco de dados e fila
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Imagens e vídeos das automações
# ─────────────────────────────────────────────────────────────────────────────
# Pasta onde o app WEB grava as mídias enviadas (servidas em /media/...). Em
# produção, monte um volume persistente nela; a imagem Docker já define
# UPLOADS_DIR=/data/uploads (Dockerfile).
# O worker não precisa desta pasta. Sem a variável: ./uploads.
# UPLOADS_DIR=/data/uploads
# Cota de mídia por espaço de trabalho, em MB (padrão 500).
# MEDIA_WORKSPACE_QUOTA_MB=500

# ─────────────────────────────────────────────────────────────────────────────
# E-mail (link de acesso, boas-vindas e redefinição de senha)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=Sua Marca <acesso@suaempresa.com.br>
# Opcional: seu próprio SMTP no lugar do Resend (codifique @ como %40).
# EMAIL_SERVER=smtps://login%40suaempresa.com.br:senha@smtp.suaempresa.com.br:465

# Opcional: limita ainda mais quem pode entrar (além do cadastro fechado).
# ALLOWED_EMAILS=cliente1@loja.com.br,cliente2@loja.com.br

# ─────────────────────────────────────────────────────────────────────────────
# Meta / Instagram
# ─────────────────────────────────────────────────────────────────────────────
META_GRAPH_API_VERSION=v25.0
# Segredo do app Meta (Configurações do app > Básico). Valida a assinatura
# X-Hub-Signature-256 dos webhooks e o signed_request dos callbacks de exclusão.
FACEBOOK_APP_SECRET=your-meta-app-secret
# Token que você inventa e cola no painel da Meta ao configurar o webhook.
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Opção A — Login unificado (apps criados a partir de out/2026; ver GUIA_META_APP_REVIEW.md).
# Cole a URL de login da configuração "API setup with Unified login"; o app usa
# o client_id e o config_id dela e sempre substitui redirect_uri e state.
# META_UNIFIED_LOGIN_URL=https://www.facebook.com/v25.0/dialog/oauth?client_id=SEU_APP_ID&config_id=SEU_CONFIG_ID
# Alternativa à URL (ou para sobrescrever os valores dela):
# META_APP_ID=
# META_LOGIN_CONFIG_ID=

# Opção B — Login do Instagram (só apps antigos que ainda oferecem
# "API setup with Instagram login"). Descomente APENAS se usar essa opção, e
# com os valores reais: um segredo de exemplo aqui permitiria forjar webhooks
# e pedidos de exclusão de dados. Ignorado para novas conexões quando a opção A
# está configurada; contas já conectadas por ele continuam funcionando.
# INSTAGRAM_APP_ID=your-instagram-app-id
# INSTAGRAM_APP_SECRET=your-instagram-app-secret

# Métricas de alcance/visualizações exigem instagram_business_manage_insights
# (ou instagram_manage_insights no login unificado). Só ligue depois que a Meta
# aprovar essa permissão para o seu app.
# INSTAGRAM_INSIGHTS_ENABLED=true
